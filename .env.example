## Database Configuration
# DB_TYPE: "mongodb" or "postgres"
DB_TYPE=mongodb

# MongoDB (only needed if DB_TYPE=mongodb)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/authkit_pro

# PostgreSQL (only needed if DB_TYPE=postgres)
# POSTGRES_URI=postgresql://user:password@localhost:5432/authkit_pro
# POSTGRES_SSL=false

PORT=5000
JWT_SECRET=your_super_secret_jwt_key_change_this
NODE_ENV=development

# App branding (used in emails and sender name)
APP_NAME=AuthKit Pro

# Email Provider: "mailtrap" (default) or "resend"
# NOTE: Both providers require a verified custom domain to deliver to real users in production.
# Without a domain, emails only reach a test inbox (Mailtrap) or your own verified address (Resend).
EMAIL_PROVIDER=mailtrap

# Mailtrap — sandbox email testing (https://mailtrap.io)
MAILTRAP_TOKEN=your_mailtrap_api_token
MAILTRAP_INBOX_ID=your_inbox_id
MAILTRAP_ENDPOINT=https://send.api.mailtrap.io/

# Resend — free tier: 3,000 emails/month (https://resend.com)
# Without a verified domain, from must be onboarding@resend.dev and to must be your own verified email.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Frontend URL
CLIENT_URL=http://localhost:5173

# Google OAuth (optional — get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
